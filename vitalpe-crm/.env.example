# =============================================================================
# VITALPE CRM — variables d'entorn
#
# Obligatòries per arrencar:  NEXT_PUBLIC_APP_URL, APP_ENCRYPTION_KEY i,
# en producció, el bloc SUPABASE. Tota la resta és opcional: sense credencials
# la integració corresponent passa al proveïdor local i l'aplicació continua
# sent plenament utilitzable.
# =============================================================================

# APP ─────────────────────────────────────────────────────────────────────────
# (servidor + client) URL pública de l'aplicació. Serveix per als enllaços
# profunds que s'envien a Google Calendar i a l'app mòbil.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# (client) esquema de l'app mòbil per als enllaços profunds.
MOBILE_APP_SCHEME=vitalpe
# (SERVIDOR — secret) clau mestra de xifratge dels tokens OAuth desats.
# Genera-la amb:  openssl rand -base64 48
APP_ENCRYPTION_KEY=

# BASE DE DADES ───────────────────────────────────────────────────────────────
# (SERVIDOR) cadena de connexió directa a Postgres. Si no s'indica, en
# desenvolupament s'utilitza la base de dades local PGlite de .data/crm.
DATABASE_URL=

# SUPABASE ────────────────────────────────────────────────────────────────────
# (client) URL del projecte i clau anònima.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (SERVIDOR — secret) mai al navegador ni a l'app mòbil. Salta l'RLS.
SUPABASE_SERVICE_ROLE_KEY=

# GOOGLE OAUTH ────────────────────────────────────────────────────────────────
# (SERVIDOR) sense aquestes variables el calendari funciona amb el proveïdor
# local i la pantalla d'integracions ho indica.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=

# ANTHROPIC ───────────────────────────────────────────────────────────────────
# (SERVIDOR) interpretació de notes de veu. Sense clau s'utilitza
# l'intèrpret determinista local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# TRANSCRIPCIÓ ────────────────────────────────────────────────────────────────
# (SERVIDOR) 'openai' o 'local'. Amb 'local' es pot enganxar la transcripció
# manualment i la resta del flux funciona igual.
TRANSCRIPTION_PROVIDER=local
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# MÒBIL ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PROJECT_ID=

# GEOCODIFICACIÓ (opcional) ───────────────────────────────────────────────────
# Sense proveïdor, les ubicacions queden com a PENDENT DE GEOLOCALITZAR.
GEOCODING_PROVIDER=none
GOOGLE_MAPS_API_KEY=

# OBSERVABILITAT (opcional) ───────────────────────────────────────────────────
SENTRY_DSN=
