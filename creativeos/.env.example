# Copia a .env (gitignored) y rellena con los valores de tu proyecto Supabase
# (Settings → API). La ANON key es pública por diseño; la SERVICE key NUNCA va aquí
# (esa vive solo en ads-agent/config/.supabase_service_key para el pipeline).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
